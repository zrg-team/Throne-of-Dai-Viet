{
  "name": "van-thang",
  "version": "0.3.2",
  "private": true,
  "homepage": "https://zrg-team.github.io/ten-thousand-victories/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrg-team/ten-thousand-victories.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5179",
    "perf:gates": "node test_scripts/perf/gl-gates.mjs",
    "perf:ui": "node test_scripts/perf/measure-ui.mjs",
    "perf:beat": "node test_scripts/perf/measure-battle-beat.mjs",
    "perf:bake": "node test_scripts/perf/measure-bake.mjs",
    "verify:listeners": "node test_scripts/verify/verify-listeners.mjs",
    "verify:ladder": "node test_scripts/verify/verify-ladder.mjs",
    "verify:perf": "node test_scripts/verify/verify-listeners.mjs && node test_scripts/verify/verify-fps-cap.mjs && node test_scripts/verify/verify-tick-clock.mjs",
    "build": "tsc && vite build && node scripts/build-sw.mjs",
    "build:shell": "tsc && vite build --mode shell",
    "mobile:sync": "yarn build:shell && npm --prefix apps/mobile run sync",
    "mobile:link": "npm --prefix apps/mobile run link",
    "mobile:android": "npm --prefix apps/mobile run android:apk",
    "mobile:android:aab": "npm --prefix apps/mobile run android:aab",
    "mobile:ios:ipa": "yarn build:shell && npm --prefix apps/mobile run sync && npm --prefix apps/mobile run ios:ipa",
    "mobile:ios:check": "npm --prefix apps/mobile run ios:check",
    "mobile:ios": "npm --prefix apps/mobile run ios:eas",
    "preview": "vite preview --host 0.0.0.0",
    "icon": "node scripts/build-icon.mjs",
    "icon:check": "node scripts/build-icon.mjs --check",
    "faces": "node scripts/build-faces.mjs",
    "faces:check": "node scripts/build-faces.mjs --check",
    "fonts": "node scripts/fetch-fonts.mjs",
    "sw": "node scripts/build-sw.mjs",
    "skills": "node scripts/sync-phaser-skills.mjs",
    "skills:check": "node scripts/sync-phaser-skills.mjs --check"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
